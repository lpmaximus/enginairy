# Exemplo de variáveis de ambiente — copie para .env.local e preencha.
# NÃO commitar .env.local (contém segredos).

# ─── Banco de dados (Neon PostgreSQL) ────────────────────────────────────────
DATABASE_URL=

# ─── Cloudflare R2 (memoriais PDF/DOCX, plantas, catálogos OEM) ──────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=enginairy
R2_PUBLIC_URL=

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Asaas (pagamentos BR) ───────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ─── ECE (Enginairy Core Engine) — motor de cálculo/memorial ─────────────────
# local  = calcula e gera o documento no próprio runtime Node (padrão)
# worker = delega a um worker externo que responde via webhook
ECE_PROVIDER=local
ECE_WORKER_URL=
ECE_WORKER_TOKEN=
ECE_WEBHOOK_SECRET=

# ─── E-mail transacional ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Enginairy <nao-responda@enginairy.com>"

# ─── Crons / URL pública para webhooks (ngrok em dev, domínio em prod) ───────
CRON_SECRET=
PUBLIC_BASE_URL=

# ─── Flags e analytics ───────────────────────────────────────────────────────
MAINTENANCE_MODE=false
BETA_FULL_ACCESS=false
INTERNAL_TEST_EMAILS=

# E-mails promovidos a 'admin' automaticamente no login/cadastro — ver
# src/lib/adminEmails.ts. Cargo de PRODUTO (capabilities), não é o mesmo
# que o ADMIN_PASSWORD do painel /admin (esse é senha compartilhada, não
# por e-mail).
ADMIN_EMAILS=

# Tag do GA4 no site público (vai no HTML — pública por natureza). Sem ela,
# nenhum script de analytics é carregado: é assim que dev e preview ficam fora
# da propriedade de produção.
NEXT_PUBLIC_GA_ID=

# Leitura server-side da Data API, usada por /admin/audiencia. Autenticado
# como o dono da propriedade GA4 (OAuth, não conta de serviço — GCP bloqueia
# criação de chave de conta de serviço por padrão em projetos novos).
# PROPERTY_ID é o número, não o "G-". Passo a passo completo em docs/ga4-setup.md.
GA4_PROPERTY_ID=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=
